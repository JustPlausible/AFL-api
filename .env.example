# General
ENVIRONMENT=development
LOG_LEVEL=INFO

# Admin UI
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-secret

# Database
DB_PATH=data/afl_players.db

# AFL site configuration
AFL_COMPETITION_CODE=AFL
AFL_COMPETITION_PROVIDER_ID=CD_C014
AFL_SEASON_YEAR=2026
# Legacy numeric/provider settings remain available to older scrapers. These
# illustrative 2025 values are not the canonical 2026 selectors above; verify
# current provider values before using a legacy workflow.
AFL_COMPETITION_ID=1
AFL_SEASON_ID=73
AFL_SEASON_PID=CD_S2025014
AFL_BASE_URL=https://www.afl.com.au

# Scraper behavior
SCRAPER_TIMEOUT=10

# Optional local Compose ports
AFL_API_PORT=8000
AFL_ADMIN_PORT=8001
# Interrupted-attempt recovery (lease expiry is the primary ownership signal)
AFL_RECOVERY_MAX_ATTEMPT_SECONDS=1800
AFL_RECOVERY_REGISTRY_STALE_SECONDS=1800
AFL_RECOVERY_SCRAPE_RUN_STALE_SECONDS=1800
AFL_RECOVERY_SHUTDOWN_GRACE_SECONDS=120
AFL_SCHEDULER_HEARTBEAT_SECONDS=15
AFL_RECOVERY_STARTUP_CANDIDATE_LIMIT=500
# Diagnostic evidence-capture framework (see docs/diagnostics_framework.md). Disabled
# by default. AFL_DIAGNOSTIC_PROFILES is a comma-separated list of checked-in profile
# names to enable, e.g. AFL_DIAGNOSTIC_PROFILES=match_clock,interchange -- never
# arbitrary code. Each profile is independently selectable/schedulable, so either
# name may be listed alone or together.
AFL_DIAGNOSTICS_ENABLED=false
AFL_DIAGNOSTIC_PROFILES=match_clock,interchange
# match_clock profile (Issue #148): quarter/half/three-quarter/full-time investigation.
AFL_DIAGNOSTIC_MATCH_CLOCK_INTERVAL_SECONDS=15
AFL_DIAGNOSTIC_MATCH_CLOCK_KICKOFF_TOLERANCE_SECONDS=600
AFL_DIAGNOSTIC_MATCH_CLOCK_POST_LIVE_GRACE_SECONDS=600
# Deprecated PR #175 names (still honoured as a fallback when the AFL_DIAGNOSTIC_*
# names above are unset -- see config.py): AFL_CAPTURE_MATCH_STATE_EVIDENCE,
# AFL_MATCH_STATE_CAPTURE_INTERVAL_SECONDS,
# AFL_MATCH_STATE_CAPTURE_KICKOFF_TOLERANCE_SECONDS,
# AFL_MATCH_STATE_CAPTURE_POST_LIVE_GRACE_SECONDS.
# interchange profile (Issue #193): matchInterchange evidence-capture investigation.
AFL_DIAGNOSTIC_INTERCHANGE_INTERVAL_SECONDS=15
AFL_DIAGNOSTIC_INTERCHANGE_KICKOFF_TOLERANCE_SECONDS=600
AFL_DIAGNOSTIC_INTERCHANGE_POST_LIVE_GRACE_SECONDS=600
